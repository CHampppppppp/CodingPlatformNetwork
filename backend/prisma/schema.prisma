generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mysql"
}

/// 学习场景
model LearningScenario {
  id        String               @id @default(cuid())
  code      String               @unique
  nameZh    String
  sortOrder Int                  @default(0)
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  nodes     GraphNode[]
  sessions  InteractionSession[]

  @@map("learning_scenarios_test")
}

/// 学校/校区节点，顶级组织单位
model School {
  id        String          @id @default(cuid())
  name      String          @unique
  createdAt DateTime        @default(now())
  grades    Grade[]
  teachers  TeacherProfile[]

  @@map("schools_test")
}

/// 年级节点，属某一学校
model Grade {
  id        String           @id @default(cuid())
  schoolId  String
  gradeName Int
  createdAt DateTime         @default(now())
  classes   SchoolClass[]
  school    School           @relation(fields: [schoolId], references: [id])
  teachers  TeacherProfile[]

  @@unique([schoolId, gradeName])
  @@index([schoolId])
  @@map("grades_test")
}

/// 班级节点，属某一年级
model SchoolClass {
  id          String         @id @default(cuid())
  gradeId     String
  className   String
  teacherId   String?        @unique
  createdAt   DateTime       @default(now())
  grade       Grade          @relation(fields: [gradeId], references: [id])
  teacher     TeacherProfile?
  teacherNode GraphNode?     @relation("ClassTeacherNode", fields: [teacherId], references: [id])

  @@unique([gradeId, className])
  @@index([gradeId])
  @@map("classes_test")
}

/// 三元交互网络的核心节点表
/// nodeType 取值: Student | Teacher | Knowledge | Class | School | Grade
/// 通过 nodeType 区分不同类型节点，关联的扩展信息存储在对应的 Profile 表中
model GraphNode {
  id                String                      @id @default(cuid())
  nodeType          String
  displayName       String
  scenarioId        String
  schoolId          String?
  gradeId           String?
  classId           String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  scenario          LearningScenario            @relation(fields: [scenarioId], references: [id])
  sourceEdges                 Interaction[]               @relation("SourceNode")
  targetEdges                 Interaction[]               @relation("TargetNode")
  studentKnowledgeRelations   StudentKnowledgeRelation[]  @relation("StudentKnowledgeStudent")
  knowledgeStudentRelations   StudentKnowledgeRelation[]  @relation("StudentKnowledgeKnowledge")
  knowledgeProfile            KnowledgeProfile?
  resourceRelations           ResourceKnowledgeRelation[]
  cognitiveProfiles           StudentCognitiveProfile[]
  studentProfile              StudentProfile?
  studentWorks                StudentWork[]
  teacherStudentWorks         StudentWork[]     @relation("TeacherStudentWorks")
  teacherProfile              TeacherProfile?
  teachingClass               SchoolClass?    @relation("ClassTeacherNode")

  @@index([nodeType])
  @@index([scenarioId])
  @@index([schoolId, gradeId, classId])
  @@map("graph_nodes_test")
}

/// 学生节点扩展属性，1:1 关联 GraphNode (nodeType = Student)
model StudentProfile {
  nodeId                String    @id
  externalUserId        String?
  gender                String?
  learningStyle         String?
  personality           String?
  groupBehavior         String?
  aiContentSatisfaction String?
  resourceHelpfulness   String?
  posterSatisfaction    String?
  teachingPreference    String?
  helpSource            String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  node                  GraphNode @relation(fields: [nodeId], references: [id])

  @@index([externalUserId])
  @@map("student_profiles_test")
}

/// 教师节点扩展属性，1:1 关联 GraphNode (nodeType = Teacher)
model TeacherProfile {
  nodeId        String      @id
  subject       String?
  teachingGrade Int?
  teachingClass String?
  schoolId      String?
  gradeId       String?
  classId       String?     @unique
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  node          GraphNode   @relation(fields: [nodeId], references: [id])
  school        School?     @relation(fields: [schoolId], references: [id])
  grade         Grade?      @relation(fields: [gradeId], references: [id])
  class         SchoolClass? @relation(fields: [classId], references: [id])

  @@map("teacher_profiles_test")
}

/// 知识点节点扩展属性，1:1 关联 GraphNode (nodeType = Knowledge)
model KnowledgeProfile {
  nodeId        String    @id
  content       String?   @db.Text
  knowledgeType String?
  category      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  node          GraphNode @relation(fields: [nodeId], references: [id])

  @@map("knowledge_profiles_test")
}

/// 一次交互会话，记录某学习场景在某班级/时间下的完整交互记录
model InteractionSession {
  id                String                    @id @default(cuid())
  scenarioId        String
  schoolId          String
  gradeId           String
  classId           String?
  sessionName       String?
  occurredAt        DateTime
  createdAt         DateTime                  @default(now())
  scenario          LearningScenario          @relation(fields: [scenarioId], references: [id])
  interactions      Interaction[]
  classroomAnalysis SessionClassroomAnalysis?
  studentWorks      StudentWork[]

  @@index([scenarioId, occurredAt])
  @@index([schoolId, gradeId, classId, occurredAt])
  @@map("interaction_sessions_test")
}

/// 三元交互网络的有向边
/// sourceNode -> targetNode 表示从源节点到目标节点的交互关系
/// interactionType 区分交互类型（物理空间采集(PHYSICAL) ｜ 平台采集(PLATFORM)）
/// actionType 为可选的细分子类型
/// strength 表示交互强度/频次，decimal(10,4) 保证精度
model Interaction {
  id              String             @id @default(cuid())
  interactionType String             @db.VarChar(50)
  createdAt       DateTime           @default(now())
  actionType      String?            @db.VarChar(50)
  durationSec     Int?
  sessionId       String
  sourceNodeId    String
  strength        Decimal            @db.Decimal(10, 4)
  targetNodeId    String
  relationSourceId String?
  session          InteractionSession           @relation(fields: [sessionId], references: [id])
  sourceNode       GraphNode                    @relation("SourceNode", fields: [sourceNodeId], references: [id], onUpdate: NoAction)
  targetNode       GraphNode                    @relation("TargetNode", fields: [targetNodeId], references: [id], onUpdate: NoAction)
  relationSource   StudentKnowledgeRelation?    @relation(fields: [relationSourceId], references: [id], onDelete: SetNull)

  @@unique([sessionId, sourceNodeId, targetNodeId, interactionType, actionType])
  @@index([sessionId])
  @@index([sourceNodeId, targetNodeId])
  @@index([interactionType, createdAt])
  @@index([targetNodeId], map: "interactions_test_targetNodeId_fkey")
  @@map("interactions_test")
}

/// 认知维度定义表，枚举所有可测量的认知能力维度
/// dimensionCode 为维度唯一标识，minScore/maxScore 定义该维度的量表范围
model CognitiveDimensionDef {
  id              String                           @id @default(cuid())
  dimensionCode   String                           @unique
  dimensionNameZh String
  category        String
  minScore        Decimal                          @db.Decimal(5, 2)
  maxScore        Decimal                          @db.Decimal(5, 2)
  sortOrder       Int                              @default(0)
  isActive        Boolean                          @default(true)
  dimensionScores StudentCognitiveDimensionScore[]

  @@map("cognitive_dimension_defs_test")
}

/// 学生认知能力画像，按时间版本生成
/// profileVersion 标识画像版本，generatedAt 为实际计算时间点
/// totalScore 为该时间点认知能力综合得分
model StudentCognitiveProfile {
  id              String                           @id @default(cuid())
  studentNodeId   String
  profileVersion  String
  generatedAt     DateTime
  totalScore      Decimal                          @db.Decimal(5, 2)
  createdAt       DateTime                         @default(now())
  dimensionScores StudentCognitiveDimensionScore[]
  studentNode     GraphNode                        @relation(fields: [studentNodeId], references: [id])

  @@index([studentNodeId, generatedAt(sort: Desc)])
  @@map("student_cognitive_profiles_test")
}

/// 学生认知维度得分，关联至 CognitiveDimensionDef
/// scoreLevel 表示该维度的评级（如高/中/低）
model StudentCognitiveDimensionScore {
  id            String                  @id @default(cuid())
  profileId     String
  dimensionCode String
  scoreValue    Decimal                 @db.Decimal(5, 2)
  scoreLevel    String
  createdAt     DateTime                @default(now())
  dimensionDef  CognitiveDimensionDef   @relation(fields: [dimensionCode], references: [dimensionCode])
  profile       StudentCognitiveProfile @relation(fields: [profileId], references: [id])

  @@unique([profileId, dimensionCode])
  @@index([profileId])
  @@index([dimensionCode], map: "student_cognitive_dimension_scores_test_dimensionCode_fkey")
  @@map("student_cognitive_dimension_scores_test")
}

/// 资源表，存储资源中心展示的学习资源
/// resourceType 取值: VIDEO | ARTICLE | PRACTICE | GAME | DOCUMENT
model Resource {
  id                 String                      @id @default(cuid())
  title              String
  description        String?
  url                String?
  resourceType       String
  acceptanceRate     Decimal?                    @db.Decimal(5, 2)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  knowledgeRelations ResourceKnowledgeRelation[]
  studentRates       StudentResourceRate[]

  @@index([resourceType])
  @@map("resources_test")
}

/// 资源与知识点的关联表，支持一个资源关联多个知识点
model ResourceKnowledgeRelation {
  id              String    @id @default(cuid())
  resourceId      String
  knowledgeNodeId String
  knowledgeNode   GraphNode @relation(fields: [knowledgeNodeId], references: [id], onDelete: Cascade)
  resource        Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, knowledgeNodeId])
  @@index([knowledgeNodeId])
  @@map("resource_knowledge_relations_test")
}

/// 学生对资源的评分表
model StudentResourceRate {
  id         String   @id @default(cuid())
  studentId  String
  resourceId String
  rate       Decimal  @db.Decimal(3, 2)
  createdAt  DateTime @default(now())
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([studentId, resourceId])
  @@index([resourceId])
  @@map("student_resource_rates_test")
}

/// 学生与知识点的关联表，记录学生学习了哪些知识点
/// 作为学生-知识点关系的权威数据源，自动同步到 interactions 表
model StudentKnowledgeRelation {
  id              String    @id @default(cuid())
  studentNodeId   String
  knowledgeNodeId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  studentNode     GraphNode       @relation("StudentKnowledgeStudent", fields: [studentNodeId], references: [id], onDelete: Cascade)
  knowledgeNode   GraphNode       @relation("StudentKnowledgeKnowledge", fields: [knowledgeNodeId], references: [id], onDelete: Cascade)
  derivedInteractions Interaction[]

  @@unique([studentNodeId, knowledgeNodeId])
  @@index([studentNodeId])
  @@index([knowledgeNodeId])
  @@map("student_knowledge_relations_test")
}

/// 学生作品表，存储学生创作的作品信息
/// 关联至 GraphNode (nodeType = Student) 和 InteractionSession
model StudentWork {
  id               String              @id @default(cuid())
  studentNodeId    String
  sessionId        String?
  externalWorkId   String?             @unique
  workName         String
  publishedAt      DateTime?
  /// 作品所属主题信息
  themeId          String?
  themeName        String?
  themeDirectory   String?
  textbookName     String?
  /// 作品互动数据
  likeCount        Int                 @default(0)
  commentCount     Int                 @default(0)
  /// 教师评分
  teacherId        String?
  teacherScore     Decimal?            @db.Decimal(5, 2)
  teacherComment   String?             @db.Text
  /// 点赞详情（JSON 数组，存储点赞学生信息）
  likeDetails      String?             @db.Text
  /// 评论详情（JSON 数组，存储评论内容和学生信息）
  commentDetails   String?             @db.Text
  /// 埋点数据
  activityLogCount Int                 @default(0)
  activityLogMeta  String?             @db.Text
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  session          InteractionSession? @relation(fields: [sessionId], references: [id])
  studentNode      GraphNode           @relation(fields: [studentNodeId], references: [id], onDelete: Cascade)
  teacher          GraphNode?          @relation("TeacherStudentWorks", fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([studentNodeId])
  @@index([sessionId])
  @@index([externalWorkId])
  @@index([teacherId])
  @@map("student_works_test")
}

/// 课堂视频自动分析报告，存储基于课堂视频分析框架的九维度评估结果
model SessionClassroomAnalysis {
  id                             String             @id @default(cuid())
  sessionId                      String             @unique
  knowledgeActivationRate        Decimal?           @db.Decimal(5, 2)
  activatedKnowledgeCount        Int?
  totalKnowledgeCount            Int?
  behavioralEngagementLevel      String?
  teacherStudentInteractionCount Int?
  peerCollaborationCount         Int?
  cognitiveEngagementLevel       String?
  constructiveUtteranceCount     Int?
  hasBurnout                     Boolean?
  hasFrustration                 Boolean?
  conceptDevelopmentLevel        String?
  feedbackQualityLevel           String?
  academicExpectationLevel       String?
  closedQuestionCount            Int?
  applicationQuestionCount       Int?
  openQuestionCount              Int?
  acceptFeedbackCount            Int?
  praiseFeedbackCount            Int?
  extendFeedbackCount            Int?
  correctFeedbackCount           Int?
  studentUtteranceCount          Int?
  teacherFluencyLevel            String?
  toolVarietyCount               Int?
  selfAwarenessLevel             String?
  selfManagementLevel            String?
  collectiveManagementLevel      String?
  ruleClarityLevel               String?
  positiveReinforcementLevel     String?
  negativeReductionLevel         String?
  createdAt                      DateTime           @default(now())
  updatedAt                      DateTime           @updatedAt
  session                        InteractionSession @relation(fields: [sessionId], references: [id])

  @@map("session_classroom_analyses_test")
}
